# ============================================================================
#  Rollercoaster — blok config BERSAMA (dipakai ketiga build)
#  Basis: 4.14.357 OpenELA untuk miatoll
#
#  Isi: (a) perbaikan performa yang terbukti dari audit 61.98/61.99
#        (b) dukungan Android 17 tetap utuh (eBPF/EROFS/FBE v2)
#  Tidak berisi root stack → itu ada di profil masing-masing.
# ============================================================================

# --- ramdisk LZ4 (boot.img ROM A16/A17 memakai lz4) -------------------------
CONFIG_RD_LZ4=y

# --- log buffer + audit -----------------------------------------------------
CONFIG_LOG_BUF_SHIFT=20
CONFIG_LOG_CPU_MAX_BUF_SHIFT=12
CONFIG_AUDIT=y

# --- EROFS (partisi read-only ROM modern) -----------------------------------
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y

# --- eBPF era 5.10 (WAJIB Android 16 QPR2 / 17; kalau hilang -> bootloop) ---
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BPF_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y

# --- FBE v2 / metadata encryption (OrangeFox/TWRP generasi baru) ------------
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_CRYPTO_DEV_QCOM_ICE=y

# --- BEBAN DEBUG DIMATIKAN (hasil audit 61.98 -> 61.99) ---------------------
# BUG_ON_DATA_CORRUPTION men-SELECT DEBUG_LIST: dua-duanya harus turun bareng
# CONFIG_BUG_ON_DATA_CORRUPTION is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_CFQ_GROUP_IOSCHED is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_IRQ_TIME_ACCOUNTING is not set
# CONFIG_DEBUG_INFO is not set

# --- memori: zram lz4 + frontswap (RAM 4-6 GB: ini yang paling terasa) ------
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_FRONTSWAP=y

# --- jaringan: BBR + fq_codel (latency lebih rendah, penting buat game) -----
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
# CONFIG_DEFAULT_PFIFO_FAST is not set
CONFIG_DEFAULT_FQ_CODEL=y

# --- paritas kernel ROM (dipakai VPN/firewall/HID) --------------------------
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y
CONFIG_NF_LOG_COMMON=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y
CONFIG_HIDRAW=y
CONFIG_ZSTD_DECOMPRESS=y
CONFIG_CRYPTO_ZSTD=y

# --- sched yang memang dipakai kode tree ini --------------------------------
CONFIG_SCHED_WALT=y
CONFIG_SCHED_CORE_CTL=y
CONFIG_SCHED_TUNE=y
CONFIG_MSM_PERFORMANCE=y
# SCHED_INFO depends on SCHEDSTATS (yang di bawah ini sengaja n) -> permintaan
# =y tidak akan pernah tercapai. Dinyatakan n supaya audit jujur.
# CONFIG_SCHED_INFO is not set
CONFIG_SLUB_CPU_PARTIAL=y
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_F2FS_STAT_FS=y

# --- debug yang tetap dibutuhkan (jangan dimatikan) -------------------------
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_TRACING=y
