# ============================================================================
#  Rollercoaster-CRITICAL — KernelSU-Next · GAMING · FPS tinggi
#  Semua tuas performa yang tersedia di tree 4.14 dinyalakan.
# ============================================================================

# --- root stack + hiding lengkap (game/banking berbasis deteksi tetap aman) -
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
# SUS_MEMFD tidak dipakai: implementasi SuSFS di tree ini belum punya
# susfs_add_sus_memfd() -> build gagal (error: use of undeclared identifier)
# CONFIG_KSU_SUSFS_SUS_MEMFD is not set
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
# CONFIG_KSU_SUSFS_ENABLE_LOG is not set
# CONFIG_KSU_SUSFS_TRY_UMOUNT is not set
CONFIG_NOMOUNT=y

# --- CPU: tick lebih rapat + governor performa -----------------------------
# HZ 300: respons input/thread lebih cepat dari 100 Hz (HZ 1000 terlalu boros)
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
CONFIG_HZ_300=y
CONFIG_HZ=300
CONFIG_PREEMPT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# input boost + msm_performance: naikkan frekuensi saat sentuh/rame
CONFIG_CPU_BOOST=y
CONFIG_MSM_PERFORMANCE=y
CONFIG_SCHED_TUNE=y
CONFIG_SCHED_WALT=y
CONFIG_SCHED_CORE_CTL=y

# --- IO: deadline (latency baca/tulis lebih rendah untuk loading game) -----
CONFIG_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_CFQ=y
CONFIG_DEFAULT_IOSCHED="deadline"
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_DEADLINE=y

# --- GPU: Adreno governor msm-adreno-tz (default tree) --------------------
CONFIG_QCOM_KGSL=y
CONFIG_QCOM_KGSL_IOMMU=y
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y

# --- memori: lz4 (blok bersama) + keep zram aktif --------------------------
CONFIG_ZRAM=y
CONFIG_FRONTSWAP=y

# --- matikan sisa tracing yang tidak dipakai saat main --------------------
# HANYA function tracer yang dimatikan. CONFIG_FTRACE harus TETAP y: seluruh
# menu UPROBE_EVENTS/BPF_EVENTS berada di dalam "if FTRACE", jadi mematikannya
# membuat BPF_EVENTS hilang -> Android 16 QPR2/17 bootloop.
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_NETFILTER_XT_TARGET_TRACE is not set
