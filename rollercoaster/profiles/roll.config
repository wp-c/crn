# =============================================================================
#  roll.config — Rollercoaster-Roll : build "satu paket untuk semua" (Roll 3.3)
#
#  Roll = paket AK3 harian + ROM port sekaligus:
#    . root stack sama dengan Chronicle (KSU + SuSFS penuh + NoMount)
#    . kompatibilitas modul ROM port: MODULE_SIG mati, MODVERSIONS mati
#    . diagnosa bootloop: pstore/ramoops hidup
#    . f2fs compression + BFQ tersedia (default tetap cfq, aman untuk ROM port)
#
#  Beda dengan PortN: PortN sengaja TANPA NoMount (metamodule/Zygisk), Roll
#  memakai NoMount karena mayoritas pengguna Roll ada di ROM AOSP/Lineage.
#  Kalau Roll dipasang di ROM port yang menuntut mount nyata -> pakai PortN.
# =============================================================================

# --- root stack --------------------------------------------------------------
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KSU_SYSCALL_TABLE_HOOK is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DEBUG is not set

# --- SuSFS: paket lengkap yang ADA di tree ini -------------------------------
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
# CONFIG_KSU_SUSFS_ENABLE_LOG is not set
# implementasi susfs_add_try_umount()/susfs_add_sus_memfd() tidak ada di tree ini
# CONFIG_KSU_SUSFS_TRY_UMOUNT is not set
# CONFIG_KSU_SUSFS_SUS_MEMFD is not set

# --- NoMount (redireksi VFS, tanpa bind mount yang kelihatan) ---------------
CONFIG_NOMOUNT=y

# --- kompatibilitas modul ROM port ------------------------------------------
# Vendor ROM port menandatangani .ko dengan kunci mereka sendiri. Dengan
# MODULE_SIG_FORCE=y semua modul itu ditolak ("Key was rejected by service").
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y
# vermagic ROM port tidak membawa token "modversions"
# CONFIG_MODVERSIONS is not set

# --- diagnosa bootloop -------------------------------------------------------
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# --- penyimpanan ------------------------------------------------------------
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y

# --- CPU/IO: seimbang (bukan gaming), sama dengan ROM port ------------------
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
# governor "interactive" rusak di tree ini (TRANSITION_LATENCY_LIMIT)
# CONFIG_CPU_FREQ_GOV_INTERACTIVE is not set
CONFIG_CPU_BOOST=y

CONFIG_IOSCHED_CFQ=y
CONFIG_DEFAULT_IOSCHED="cfq"
CONFIG_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y

# --- memori ------------------------------------------------------------------
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_FRONTSWAP=y
# CONFIG_ZRAM_WRITEBACK is not set
