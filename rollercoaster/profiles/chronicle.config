# ============================================================================
#  Rollercoaster-CHRONICLE — KernelSU-Next · harian · fokus integrity/hiding
#  Seimbang: performa cukup, baterai wajar, jejak root seminimal mungkin.
# ============================================================================

# --- root stack -------------------------------------------------------------
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y

# --- SuSFS: SEMUA modul hiding dinyalakan (paket lengkap) -------------------
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
# SUS_MEMFD tidak dipakai: implementasi SuSFS di tree ini belum punya
# susfs_add_sus_memfd() -> build gagal (error: use of undeclared identifier)
# CONFIG_KSU_SUSFS_SUS_MEMFD is not set
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
# log SuSFS dimatikan: mengurangi beban di hot path (bisa dihidupkan via ksu_susfs)
# CONFIG_KSU_SUSFS_ENABLE_LOG is not set
# TRY_UMOUNT tidak dipakai: implementasi SuSFS di tree ini tidak punya
# susfs_add_try_umount(); memaksa =y membuat build gagal.
# CONFIG_KSU_SUSFS_TRY_UMOUNT is not set

# --- NoMount: redireksi VFS tanpa overlay/bind mount (sulit dideteksi) ------
CONFIG_NOMOUNT=y

# --- harian: governor default schedutil (hemat daya, tetap responsif) -------
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_BOOST=y

# --- IO: cfq (default tree, sudah terbukti stabil di 61.98/61.99) -----------
CONFIG_IOSCHED_CFQ=y
CONFIG_DEFAULT_IOSCHED="cfq"
