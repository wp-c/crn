# =============================================================================
#  portn.config — Rollercoaster-PortN : SATU base untuk SEMUA ROM port miatoll
#
#  Target terverifikasi (boot.img ROM dibongkar langsung, 23 Okt 2026):
#    . ColorOS 16.0.10            -> 4.14.369-Nezuko-Ganteng
#    . HyperOS 4.0.17.0 Semi-Stbl -> 4.14.369-Nezuko-Ganteng
#    . HyperOS 3.0.3.0 peace.su   -> kernel peace.su (boot img non-standar)
#    . HyperOS 2.0.209.0          -> EvaCORE Kernel
#    . ColorOS 15 Lite            -> EvaCORE / ArtKernel
#  Semua 4.14 => satu generasi dengan base kita (4.14.357 openela).
#
#  Prinsip: MONOLITIK (qcacld/touch/sensor/audio =y) + modul ROM DIIZINKAN.
#  Fitur hiding SuSFS dinyalakan penuh supaya deteksi root (DevCheck dkk)
#  bisa ditutup dari sisi Manager tanpa memaksa SELinux permissive.
# =============================================================================

# --- root stack --------------------------------------------------------------
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# Kprobes/syscall-table TIDAK dipakai: manual hook yang stabil di 4.14 non-GKI
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KSU_SYSCALL_TABLE_HOOK is not set
# Manager tetap aktif supaya APK Rollercoaster SU bisa memegang kendali
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DEBUG is not set

# --- SuSFS: seluruh modul yang ADA di tree ini -------------------------------
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
# Log SuSFS mati: mengurangi jejak & beban di hot path
# CONFIG_KSU_SUSFS_ENABLE_LOG is not set
# TIDAK ADA implementasinya di tree ini (fs/susfs.c) -> memaksa =y = build gagal
# CONFIG_KSU_SUSFS_TRY_UMOUNT is not set
# CONFIG_KSU_SUSFS_SUS_MEMFD is not set

# --- NoMount: sengaja MATI ---------------------------------------------------
# ROM port punya ranah mount sendiri (metamodule/overlayfs) dan Zygisk Next
# butuh file modul benar-benar ada di namespace zygote.
# CONFIG_NOMOUNT is not set

# --- modul: ROM port BOLEH memuat modulnya sendiri ---------------------------
# Vendor Nezuko/EvaCORE menandatangani .ko dengan kunci mereka. Dengan
# MODULE_SIG_FORCE=y semua modul itu ditolak ("Key was rejected by service").
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y
# Tanpa MODVERSIONS: vermagic ROM tidak membawa token CRC "modversions"
# CONFIG_MODVERSIONS is not set

# --- SELinux: default enforcing, bisa permissive lewat cmdline ---------------
# Zip "-permissive" memakai androidboot.selinux=permissive lewat patch_cmdline.
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
# CONFIG_SECURITY_SELINUX_DISABLE is not set

# --- diagnosa bootloop -------------------------------------------------------
# Node ramoops 4 MB sudah ada di cust-atoll.dtsi (dipakai joyeuse/curtana).
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# --- kompatibilitas ROM port -------------------------------------------------
# PREEMPT wajib y: banner kernel ROM port "4.14.369-Nezuko-Ganteng #1 SMP PREEMPT"
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT_COUNT=y

# --- penyimpanan: f2fs (dipakai ROM port) + kompresi -------------------------
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_STAT_FS=y

# --- IO: cfq tetap default (sama dengan ROM), BFQ tersedia sebagai opsi ------
CONFIG_IOSCHED_CFQ=y
CONFIG_DEFAULT_IOSCHED="cfq"
CONFIG_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y

# --- CPU: schedutil default + governor lain tersedia -------------------------
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
# governor "interactive" RUSAK di tree ini (cpufreq_interactive.c: TRANSITION_LATENCY_LIMIT)
# CONFIG_CPU_FREQ_GOV_INTERACTIVE is not set
CONFIG_CPU_BOOST=y

# --- memori: zram lz4 (sudah di 00-common) + tunable -------------------------
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_FRONTSWAP=y
# writeback zram ke disk tidak dipakai (microSD lambat, berisiko)
# CONFIG_ZRAM_WRITEBACK is not set
