# =============================================================================
#  Rollercoaster-Port — profil untuk ROM PORT miatoll
#  Target (terverifikasi dari boot.img masing-masing ROM, 23 Okt 2026):
#    . peaceSU      : kernel 4.14.356-#PeaceUnit-suicide   (HyperOS 3, A15)
#    . HyperOS 4    : kernel 4.14.369-Nezuko-Ganteng       (base Xiaomi 18 Pro)
#    . ColorOS 16   : kernel 4.14.369-Nezuko-Ganteng       (base OnePlus 12)
#  Dasar: KSU + SuSFS (seperti Chronicle) TAPI tanpa NOMOUNT, karena ROM port
#  memakai metamodule/overlayfs dan Zygisk Next butuh mount modul yang nyata.
# =============================================================================

# --- KSU + SuSFS -------------------------------------------------------------
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
# CONFIG_KSU_SUSFS_SUS_MEMFD is not set
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
# CONFIG_KSU_SUSFS_ENABLE_LOG is not set
# NOMOUNT SENGAJA MATI: ROM port punya ranah mount sendiri (metamodule/overlayfs)
# dan Zygisk Next butuh file modul benar-benar ada di namespace zygote.
# CONFIG_NOMOUNT is not set

# --- kompatibilitas modul vendor ROM port -----------------------------------
# ROM port dibangun TANPA MODVERSIONS -> vermagic mereka tidak punya token
# "modversions". Build kita harus sama supaya string-nya sepadan.
# CONFIG_MODVERSIONS is not set
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_LOAD=y
# PREEMPT wajib y: banner kernel ROM port "4.14.369-Nezuko-Ganteng #1 SMP PREEMPT"
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT_COUNT=y

# --- governor & IO: ikut ROM port (seimbang, bukan gaming) -------------------
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_BOOST=y
CONFIG_DEFAULT_IOSCHED="cfq"
CONFIG_IOSCHED_CFQ=y
CONFIG_IOSCHED_DEADLINE=y
