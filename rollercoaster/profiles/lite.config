# ============================================================================
#  Rollercoaster-LITE — NonKSU · harian · fokus baterai + integrity
#
#  Kenapa "integrity" di build tanpa root: tidak ada su, tidak ada mount modul,
#  tidak ada /data/adb/ksu -> tidak ada jejak root sama sekali untuk dideteksi.
#  (Verdict STRONG tetap butuh keybox perangkat di sisi userspace — lihat
#   output/INTEGRITY-SETUP.md; kernel tidak bisa memalsukan TEE.)
# ============================================================================

# --- root stack: MATI TOTAL -------------------------------------------------
# CONFIG_KSU is not set
# CONFIG_KSU_MANUAL_HOOK is not set
# CONFIG_KSU_SUSFS is not set
# CONFIG_KSU_SUSFS_SUS_PATH is not set
# CONFIG_KSU_SUSFS_SUS_MOUNT is not set
# CONFIG_KSU_SUSFS_SUS_KSTAT is not set
# CONFIG_KSU_SUSFS_SUS_MEMFD is not set
# CONFIG_KSU_SUSFS_SUS_MAP is not set
# CONFIG_KSU_SUSFS_SPOOF_UNAME is not set
# CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG is not set
# CONFIG_KSU_SUSFS_OPEN_REDIRECT is not set
# CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS is not set
# CONFIG_KSU_SUSFS_ENABLE_LOG is not set
# CONFIG_KSU_SUSFS_TRY_UMOUNT is not set
# CONFIG_NOMOUNT is not set

# --- baterai ---------------------------------------------------------------
# schedutil = governor hemat daya yang tetap EAS-aware
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
# input boost dimatikan: menaikkan frekuensi tiap sentuhan (boros, tidak perlu
# untuk pemakaian harian)
# CONFIG_CPU_BOOST is not set
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y

# --- IO: cfq (paling ramah untuk pemakaian campuran) -----------------------
CONFIG_IOSCHED_CFQ=y
CONFIG_DEFAULT_IOSCHED="cfq"

# --- zram/frontswap sudah ada di blok bersama; pastikan aktif --------------
CONFIG_ZRAM=y
CONFIG_FRONTSWAP=y
