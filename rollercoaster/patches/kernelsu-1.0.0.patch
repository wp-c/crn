 		revert_creds(saved_cred);
 		
 		mutex_unlock(&throne_tracker_mutex);
 		throne_tracker_first_run = false;
+		/* Rollercoaster: kalau /data belum siap pada percobaan sinkron pertama,
+		 * jangan menyerah — jadwalkan percobaan ulang lewat workqueue. */
+		if (unlikely(!throne_first_ok)) {
+			throne_data.prune_only = prune_only;
+			throne_data.retries = 0;
+			schedule_delayed_work(&throne_data.dwork, msecs_to_jiffies(100));
+		}
