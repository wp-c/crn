diff --git a/KernelSU-Next/kernel/manager/apk_sign.c b/KernelSU-Next/kernel/manager/apk_sign.c
index e4fa7d97a..4493e8db1 100644
--- a/KernelSU-Next/kernel/manager/apk_sign.c
+++ b/KernelSU-Next/kernel/manager/apk_sign.c
@@ -117,7 +117,12 @@ static bool check_block(struct file *fp, loff_t *pos, loff_t block_end, unsigned
 	if (certificate_size > INT_MAX || certificate_size > (u64)(certificates_end - *pos))
 		return false;
 
-#define CERT_MAX_LENGTH 1024
+/* Rollercoaster: sertifikat APK Manager kita berukuran 1431 byte (RSA 4096).
+ * Batas 1024 membuat seluruh pemeriksaan sidik jari menjadi kode mati
+ * (certificate_size == EXPECTED_SIZE > CERT_MAX_LENGTH -> selalu return false),
+ * sehingga Manager tidak pernah dikenali. 2048 cukup dan tetap aman untuk
+ * tumpukan kernel (buffernya lokal). */
+#define CERT_MAX_LENGTH 2048
 	if (certificate_size != expected_size)
 		return false;
 
